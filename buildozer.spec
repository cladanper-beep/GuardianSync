[app]
title = GuardianSync
package.name = guardiansync
package.domain = com.claper.guardiasync
source.include_exts = py,png,jpg,kv,atlas
source.dir = .
version = 1.2.0
requirements = python3,kivy,sqlite3
orientation = portrait
fullscreen = 0
android.permissions = CAMERA, WRITE_EXTERNAL_STORAGE, READ_EXTERNAL_STORAGE, INTERNET, USE_BIOMETRIC
android.api = 33
android.minapi = 21
android.sdk = 33
android.ndk = 25b
android.build_tools_version = 33.0.0
android.accept_sdk_license = True

